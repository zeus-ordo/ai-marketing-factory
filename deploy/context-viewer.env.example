# Copy to /opt/ai-marketing-factory/.env.context-viewer on the VM and chmod 600.
# Keep this file outside the repository. These values are injected into the
# context-viewer container only; PostgreSQL is not exposed by the Compose file.
# Use the Cloud SQL private IP or internal DNS name, not the viewer container itself.
DATABASE_URL=postgresql://app:replace-with-database-password@replace-with-cloud-sql-private-ip:5432/marketing_ai
VIEWER_USERNAME=admin
VIEWER_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-a-long-random-session-secret
