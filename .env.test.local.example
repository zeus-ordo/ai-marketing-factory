# Copy this file to .env.test.local and fill real values

# Shared base URL for scripts
REGRESSION_BASE_URL=http://localhost:3000
E2E_BASE_URL=http://localhost:3000

# Regression JWT auth account
REGRESSION_AUTH_EMAIL=replace-with-real-email
REGRESSION_AUTH_PASSWORD=replace-with-real-password

# E2E auth: prefer platform key, fallback to JWT if provided
E2E_PLATFORM_KEY=replace-with-real-platform-admin-key
E2E_AUTH_EMAIL=replace-with-real-email
E2E_AUTH_PASSWORD=replace-with-real-password

# Optional polling tuning
E2E_POLL_MAX=20
E2E_POLL_INTERVAL_MS=1500

# Image RAG enrichment worker configuration (use non-secret values here)
IMAGE_ANALYSIS_BASE_URL=http://localhost:18080
IMAGE_ANALYSIS_MODEL=vision-model
EMBEDDING_BASE_URL=http://localhost:18081
EMBEDDING_MODEL=embedding-model
IMAGE_ANALYSIS_VERSION=image-rag-v1
WORKER_ENRICHMENT_URL=http://localhost:8093
